<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageData.siteName %> | Home</title>
  <meta name="description" content="<%= pageData.siteDescription %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/home.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="<%= pageData.siteName %> home">
        <span class="brand-mark" aria-hidden="true">
          <span class="mortarboard"></span>
        </span>
        <span class="brand-text">
          <strong><%= pageData.siteName %></strong>
          <small>Initiative</small>
        </span>
      </a>

      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav">
        <span></span><span></span><span></span>
        <span class="sr-only">Toggle menu</span>
      </button>

      <nav class="site-nav" id="siteNav">
        <a href="#about">About Us</a>
        <a href="#stories">Stories</a>
        <a href="#opportunities">Opportunities</a>
        <a href="#services">Services</a>
        <a href="#partners">Partners</a>
        <a href="#contact">Contact</a>
      </nav>

      <a class="btn btn-primary header-cta" href="#contact">Get Started</a>
    </div>
  </header>

  <main>
    <section class="hero" id="about">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><%= pageData.hero.eyebrow %></p>
          <h1><%= pageData.hero.title %></h1>
          <p class="hero-text"><%= pageData.hero.description %></p>
          <div class="hero-actions">
            <a href="<%= pageData.hero.primaryCta.href %>" class="btn btn-primary"><%= pageData.hero.primaryCta.label %></a>
            <a href="<%= pageData.hero.secondaryCta.href %>" class="btn btn-secondary"><%= pageData.hero.secondaryCta.label %></a>
          </div>
        </div>

        <div class="hero-visual" aria-label="Hero visual placeholder">
          <div class="hero-image-placeholder">
            <div class="hero-image-note">Image link goes here later</div>
          </div>
        </div>
      </div>

      <div class="container stats-wrap">
        <div class="stats-grid">
          <% pageData.stats.forEach(function(stat){ %>
            <article class="stat-card">
              <div class="stat-icon" aria-hidden="true"><%= stat.icon %></div>
              <div>
                <strong><%= stat.value %></strong>
                <span><%= stat.label %></span>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section" id="services">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker"><%= pageData.servicesSection.kicker %></p>
          <h2><%= pageData.servicesSection.title %></h2>
        </div>

        <div class="service-grid">
          <% pageData.services.forEach(function(service){ %>
            <article class="service-card">
              <div class="service-icon" aria-hidden="true"><%= service.icon %></div>
              <h3><%= service.title %></h3>
              <p><%= service.description %></p>
              <a href="<%= service.href %>"><%= service.linkText %> →</a>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section section-soft" id="stories">
      <div class="container">
        <div class="section-head split-head">
          <div>
            <p class="section-kicker"><%= pageData.storiesSection.kicker %></p>
            <h2><%= pageData.storiesSection.title %></h2>
          </div>
          <a class="btn btn-secondary" href="<%= pageData.storiesSection.viewAllHref %>"><%= pageData.storiesSection.viewAllLabel %></a>
        </div>

        <div class="story-grid">
          <% pageData.stories.forEach(function(story){ %>
            <article class="story-card">
              <div class="story-photo">
                <div class="story-photo-empty">Image link goes here later</div>
              </div>
              <div class="story-body">
                <h3><%= story.title %></h3>
                <p><%= story.excerpt %></p>
                <div class="story-footer">
                  <span class="story-author">— <%= story.author %></span>
                  <a href="<%= story.href %>"><%= story.ctaText %> →</a>
                </div>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section" id="opportunities">
      <div class="container">
        <div class="section-head split-head">
          <div>
            <p class="section-kicker"><%= pageData.opportunitiesSection.kicker %></p>
            <h2><%= pageData.opportunitiesSection.title %></h2>
          </div>
          <a class="btn btn-secondary" href="<%= pageData.opportunitiesSection.viewAllHref %>"><%= pageData.opportunitiesSection.viewAllLabel %></a>
        </div>

        <div class="opportunity-grid">
          <% pageData.opportunities.forEach(function(item){ %>
            <article class="opportunity-card">
              <span class="badge <%= item.badgeClass %>"><%= item.badge %></span>
              <h3><%= item.title %></h3>
              <p class="opportunity-org"><%= item.organization %></p>
              <ul class="meta-list">
                <% item.meta.forEach(function(row){ %>
                  <li><%= row %></li>
                <% }); %>
              </ul>
              <a href="<%= item.href %>">View Details →</a>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section section-cta">
      <div class="container">
        <div class="cta-panel">
          <div>
            <p class="section-kicker"><%= pageData.cta.kicker %></p>
            <h2><%= pageData.cta.title %></h2>
            <p><%= pageData.cta.description %></p>
          </div>
          <a href="<%= pageData.cta.buttonHref %>" class="btn btn-accent"><%= pageData.cta.buttonLabel %></a>
        </div>
      </div>
    </section>

    <section class="section section-light" id="partners">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker"><%= pageData.partnersSection.kicker %></p>
          <h2><%= pageData.partnersSection.title %></h2>
        </div>

        <div class="partner-grid">
          <% pageData.partners.forEach(function(partner){ %>
            <div class="partner-card">
              <span class="partner-logo"><%= partner.logo %></span>
              <span><%= partner.name %></span>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section section-soft" id="contact">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-copy">
            <p class="section-kicker"><%= pageData.contactSection.kicker %></p>
            <h2><%= pageData.contactSection.title %></h2>
            <p><%= pageData.contactSection.description %></p>
          </div>

          <form class="contact-form" id="contactForm">
            <label>
              Full Name
              <input type="text" name="name" placeholder="Your name" required />
            </label>
            <label>
              Email Address
              <input type="email" name="email" placeholder="you@example.com" required />
            </label>
            <label>
              Message
              <textarea name="message" rows="4" placeholder="Tell us what you need..." required></textarea>
            </label>
            <button type="submit" class="btn btn-primary">Send Message</button>
            <p class="form-note" id="formNote" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <a href="/" class="brand footer-brand">
          <span class="brand-mark" aria-hidden="true">
            <span class="mortarboard"></span>
          </span>
          <span class="brand-text">
            <strong><%= pageData.siteName %></strong>
            <small>Initiative</small>
          </span>
        </a>
        <p><%= pageData.footerTagline %></p>
      </div>

      <div>
        <h3>Quick Links</h3>
        <ul>
          <li><a href="#about">About Us</a></li>
          <li><a href="#stories">Stories</a></li>
          <li><a href="#opportunities">Opportunities</a></li>
          <li><a href="#services">Services</a></li>
        </ul>
      </div>

      <div>
        <h3>Support</h3>
        <ul>
          <li><a href="#contact">Contact Us</a></li>
          <li><a href="#partners">Partnerships</a></li>
          <li><a href="#contact">Consultation</a></li>
        </ul>
      </div>

      <div>
        <h3>Newsletter</h3>
        <form class="newsletter-form" id="newsletterForm">
          <input type="email" placeholder="Enter your email" required />
          <button type="submit" aria-label="Subscribe">→</button>
        </form>
      </div>
    </div>

    <div class="container footer-bottom">
      <p>© <span id="year"></span> <%= pageData.siteName %>. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/home.js"></script>
</body>
</html>
