<section class="stats-strip container">
  <% stats.forEach(function(stat) { %>
    <article class="stat-card">
      <div class="stat-icon" aria-hidden="true"><%= stat.icon %></div>
      <div>
        <h2><%= stat.value %></h2>
        <p><%= stat.label %></p>
      </div>
    </article>
  <% }); %>
</section>
