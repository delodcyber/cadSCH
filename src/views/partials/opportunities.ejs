<section class="section-block">
  <div class="container">
    <div class="section-head section-head-row">
      <div>
        <p class="section-kicker">FEATURED OPPORTUNITIES</p>
        <h2>Scholarships & jobs</h2>
      </div>
      <a class="text-link" href="/opportunities">View All Opportunities</a>
    </div>

    <div class="opportunity-grid">
      <% opportunities.forEach(function(item) { %>
        <article class="opportunity-card">
          <span class="badge badge-<%= item.type.toLowerCase() %>"><%= item.type %></span>
          <h3><%= item.title %></h3>
          <p class="opportunity-org"><%= item.org %></p>
          <ul class="opportunity-meta">
            <% item.meta.forEach(function(metaItem) { %>
              <li><%= metaItem %></li>
            <% }); %>
          </ul>
          <a href="/opportunities"><%= item.linkText %> <span aria-hidden="true">→</span></a>
        </article>
      <% }); %>
    </div>
  </div>
</section>
